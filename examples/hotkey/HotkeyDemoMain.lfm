object HotkeyDemoForm: THotkeyDemoForm
  Left = 24
  Top = 24
  Width = 540
  Height = 180
  Caption = 'LazHIDControl Hotkey Demo'
  DefaultMonitor = dmPrimary
  Position = poDesigned
  OnCreate = FormCreate
  object Instructions: TLabel
    Left = 16
    Top = 20
    Width = 500
    Height = 44
    AutoSize = False
    WordWrap = True
    Caption = 'The hotkey is configured in the Object Inspector. Press Ctrl+Shift+F9 while another application has focus.'
  end
  object Status: TLabel
    Left = 16
    Top = 80
    Width = 500
    Height = 44
    AutoSize = False
    WordWrap = True
    Caption = 'Registering shortcut...'
  end
  object Hotkey: THIDHotkey
    ShortCut = 24696
    Enabled = True
    OnHotkey = HotkeyPressed
    OnError = HotkeyError
    Left = 464
    Top = 128
  end
end
