<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="LazHIDControl"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="Tony Stone - Original input implementation by Tom Gregorovic; hotkey support adapted from Codebot"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)\$(LCLWidgetType)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <AllowLabel Value="False"/>
          <UseAnsiStrings Value="False"/>
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Description Value="Mouse/keyboard automation, global hotkeys, input monitoring and window management for Windows and X11, with an unfinished Wayland input backend."/>
    <License Value="GPL-2.0-or-later; see source notices, COPYING.GPL2, and LICENSE"/>
    <Version Major="1" Minor="0"/>
    <Files>
      <Item>
        <Filename Value="carbonkeyinput.pas"/>
        <AddToUsesPkgSection Value="False"/>
